<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- MQTT connection to the user's own broker (see Settings screen) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".SchaltliApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.Schaltli"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config">

        <!--
            configChanges: the activity handles a turn itself rather than
            being destroyed and built again for it. Which way up this is comes
            from the project (MainActivity's requestedOrientation), so a turn
            happens when a project is installed - and a recreated activity
            runs onCreate again, which calls startLockTask() again, which puts
            Android's "Screen pinned" confirmation over the new screen every
            time. Compose reads the new configuration without any of that.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Schaltli"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!--
                Offered as a home app, so a phone that is a panel and nothing
                else can start Schaltli after every restart (HomeApp.kt).
                singleTask above: the Home key then brings back the one
                running Schaltli instead of stacking another on top of it.
            -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
    </application>

</manifest>
