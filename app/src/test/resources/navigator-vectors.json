    { "name": "beside the strip", "layout": { "edge": "left", "shows": "iconsAndText", "screenWidth": 800, "screenHeight": 480, "count": 12 }, "x": 80, "y": 200, "scroll": 0, "expected": -1 },
    { "name": "the last pixel row of the last entry", "layout": { "edge": "left", "shows": "icons", "screenWidth": 800, "screenHeight": 480, "count": 5 }, "x": 10, "y": 479, "scroll": 0, "expected": 4 },
    { "name": "the pixels left over after the last entry", "layout": { "edge": "bottom", "shows": "icons", "screenWidth": 800, "screenHeight": 480, "count": 3 }, "x": 799, "y": 420, "scroll": 0, "expected": -1 },
    { "name": "bottom, above the strip", "layout": { "edge": "bottom", "shows": "icons", "screenWidth": 800, "screenHeight": 480, "count": 3 }, "x": 100, "y": 415, "scroll": 0, "expected": -1 }
  ],
  "pageScroll": [
    { "name": "a page is five whole entries", "layout": { "edge": "left", "shows": "iconsAndText", "screenWidth": 800, "screenHeight": 480, "count": 12 }, "scroll": 0, "direction": 1, "expected": 440 },
    { "name": "the next page stops at the end", "layout": { "edge": "left", "shows": "iconsAndText", "screenWidth": 800, "screenHeight": 480, "count": 12 }, "scroll": 440, "direction": 1, "expected": 576 },
    { "name": "back a page from the end", "layout": { "edge": "left", "shows": "iconsAndText", "screenWidth": 800, "screenHeight": 480, "count": 12 }, "scroll": 576, "direction": -1, "expected": 136 },
    { "name": "back from the start: stays", "layout": { "edge": "left", "shows": "iconsAndText", "screenWidth": 800, "screenHeight": 480, "count": 12 }, "scroll": 0, "direction": -1, "expected": 0 },
    { "name": "PaperS3: ten entries a page, only 96 to go", "layout": { "edge": "bottom", "shows": "iconsAndText", "screenWidth": 960, "screenHeight": 540, "count": 12 }, "scroll": 0, "direction": 1, "expected": 96 }
  ]
