        { "id": "m", "isMaster": true },
        { "id": "a" },
        { "id": "p", "screenType": "popup" },
        { "id": "b", "hidden": true },
        { "id": "c" }
      ],
      "expected": ["a", "c"]
    },
    { "name": "no screens", "screens": [], "expected": [] }
  ],
