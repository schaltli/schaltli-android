    { "name": "4.3B right icons, 8 do not fit at 64", "layout": { "edge": "right", "shows": "icons", "screenWidth": 800, "screenHeight": 480, "count": 8 }, "expected": { "strip": { "x": 736, "y": 0, "width": 64, "height": 480 }, "entryLength": 64, "maxScroll": 32 } },
    { "name": "top, no screens", "layout": { "edge": "top", "shows": "iconsAndText", "screenWidth": 800, "screenHeight": 480, "count": 0 }, "expected": { "strip": { "x": 0, "y": 0, "width": 800, "height": 80 }, "entryLength": 88, "maxScroll": 0 } },
