{
  "about": "Shared test cases for text placeholders (docs/2026-09-25-text-placeholders.md). The designer (lib/placeholders.ts), the firmware and the Android app must all turn every `text` into `expected`. `values` maps `namespace:path` to what arrived; a reference not listed never arrived, which is the only case `??` applies to; \"\" is an empty message that did arrive. `decimal`/`thousands` default to Schweiz (\".\" and \"'\"). Copy this file byte for byte; do not edit a copy.",
  "cases": [
    { "name": "literal text stays", "text": "Hello", "expected": "Hello" },
    { "name": "a topic as it came", "text": "Tank {topic:a/bc}", "values": { "topic:a/bc": "75.193" }, "expected": "Tank 75.193" },
    { "name": "F2", "text": "Tank {topic:a/bc:F2}", "values": { "topic:a/bc": "75.193" }, "expected": "Tank 75.19" },
    { "name": "no value yet, no fallback", "text": "Tank {topic:a/bc}", "expected": "Tank " },
    { "name": "no value yet, with a format", "text": "Tank {topic:a/bc:F2}", "expected": "Tank " },
    { "name": "?? text when nothing arrived", "text": "{topic:t/name ?? \"Frischwasser\"}", "expected": "Frischwasser" },
    { "name": "?? not used once a value arrived", "text": "{topic:t/name ?? \"Frischwasser\"}", "values": { "topic:t/name": "Hauptwassertank" }, "expected": "Hauptwassertank" },
    { "name": "?? number, formatted", "text": "{topic:a/bc ?? 0:F2} %", "expected": "0.00 %" },
    { "name": "?? number not used, value formatted", "text": "{topic:a/bc ?? 0:F2} %", "values": { "topic:a/bc": "75.193" }, "expected": "75.19 %" },
    { "name": "?? text keeps its colon and brace", "text": "{topic:x ?? \"a: }b\"}", "expected": "a: }b" },
    { "name": "?? text with a format stays text", "text": "{topic:x ?? \"–\":F2}", "expected": "–" },

    { "name": "N0 English", "text": "{topic:a/bc:N0}", "values": { "topic:a/bc": "12345.6" }, "decimal": ".", "thousands": ",", "expected": "12,346" },
    { "name": "N2 Schweiz", "text": "{topic:a/bc:N2}", "values": { "topic:a/bc": "12345.678" }, "expected": "12'345.68" },
    { "name": "N2 Deutschland", "text": "{topic:a/bc:N2}", "values": { "topic:a/bc": "12345.678" }, "decimal": ",", "thousands": ".", "expected": "12.345,68" },
    { "name": "N2 Oesterreich", "text": "{topic:a/bc:N2}", "values": { "topic:a/bc": "12345.678" }, "decimal": ",", "thousands": " ", "expected": "12 345,68" },
    { "name": "F2 Deutschland", "text": "{topic:a/bc:F2}", "values": { "topic:a/bc": "12345.678" }, "decimal": ",", "thousands": ".", "expected": "12345,68" },
    { "name": "N2 custom, no thousands separator", "text": "{topic:a/bc:N2}", "values": { "topic:a/bc": "12345.678" }, "decimal": ".", "thousands": "", "expected": "12345.68" },
    { "name": "N0 below a thousand has no separator", "text": "{topic:a/bc:N0}", "values": { "topic:a/bc": "999.4" }, "expected": "999" },
    { "name": "N0 millions", "text": "{topic:a/bc:N0}", "values": { "topic:a/bc": "1234567" }, "expected": "1'234'567" },
    { "name": "N0 negative", "text": "{topic:a/bc:N0}", "values": { "topic:a/bc": "-1234567" }, "expected": "-1'234'567" },

    { "name": "half-way rounds away from zero on the digits, not a float", "text": "{topic:a:F2}", "values": { "topic:a": "75.195" }, "expected": "75.20" },
    { "name": "negative half-way rounds away from zero", "text": "{topic:a:F0}", "values": { "topic:a": "-2.5" }, "expected": "-3" },
    { "name": "below half rounds towards zero", "text": "{topic:a:F0}", "values": { "topic:a": "-2.4" }, "expected": "-2" },
    { "name": "no negative zero", "text": "{topic:a:F2}", "values": { "topic:a": "-0.001" }, "expected": "0.00" },
    { "name": "digits padded", "text": "{topic:a:F2}", "values": { "topic:a": "7" }, "expected": "7.00" },
    { "name": "carry through nines", "text": "{topic:a:F2}", "values": { "topic:a": "9.995" }, "expected": "10.00" },
    { "name": "carry adds a group", "text": "{topic:a:N0}", "values": { "topic:a": "999.5" }, "expected": "1'000" },
    { "name": "leading dot", "text": "{topic:a:F0}", "values": { "topic:a": ".5" }, "expected": "1" },
    { "name": "plus sign dropped", "text": "{topic:a:F3}", "values": { "topic:a": "+3.14159" }, "expected": "3.142" },
    { "name": "leading zeros dropped when formatted", "text": "{topic:a:F1}", "values": { "topic:a": "007.50" }, "expected": "7.5" },
    { "name": "surrounding whitespace in a payload ignored when formatted", "text": "{topic:a:F1}", "values": { "topic:a": " 21.44 " }, "expected": "21.4" },
    { "name": "F0 drops the decimal separator", "text": "{topic:a:F0}", "values": { "topic:a": "72.4" }, "expected": "72" },

    { "name": "no format: the payload exactly as it came", "text": "{topic:a}", "values": { "topic:a": "007.50" }, "expected": "007.50" },
    { "name": "not a number: shown as it is, whatever the format", "text": "{topic:a:F2}", "values": { "topic:a": "on" }, "expected": "on" },
    { "name": "comma decimal payload is not a number here", "text": "{topic:a:F1}", "values": { "topic:a": "3,5" }, "expected": "3,5" },
    { "name": "exponent notation is not a plain decimal", "text": "{topic:a:F0}", "values": { "topic:a": "1e3" }, "expected": "1e3" },
    { "name": "empty message that arrived: ?? does not apply", "text": "[{topic:a ?? \"–\"}]", "values": { "topic:a": "" }, "expected": "[]" },
    { "name": "empty message that arrived, with a format", "text": "[{topic:a:F2}]", "values": { "topic:a": "" }, "expected": "[]" },

    { "name": "doubled braces are literal braces", "text": "{{topic:a}}", "values": { "topic:a": "x" }, "expected": "{topic:a}" },
    { "name": "a lone closing brace stays", "text": "a}b", "expected": "a}b" },
    { "name": "unterminated: the rest as written", "text": "Tank {topic:a/bc", "values": { "topic:a/bc": "1" }, "expected": "Tank {topic:a/bc" },
    { "name": "old export token: unknown namespace, as written", "text": "on {screen}", "expected": "on {screen}" },
    { "name": "unknown namespace, as written", "text": "{foo:bar}", "expected": "{foo:bar}" },
    { "name": "reserved: parentheses", "text": "{(topic:a < 0 ? \"Frost\" : \"warm\")}", "values": { "topic:a": "-3" }, "expected": "{(topic:a < 0 ? \"Frost\" : \"warm\")}" },
    { "name": "reserved: an operator after the reference", "text": "{topic:a / topic:b}", "values": { "topic:a": "4", "topic:b": "2" }, "expected": "{topic:a / topic:b}" },
    { "name": "reserved: unknown format after a fallback", "text": "{topic:a ?? 0:P0}", "expected": "{topic:a ?? 0:P0}" },
    { "name": "?? needs whitespace: without it, part of the topic", "text": "[{topic:a??0}]", "values": { "topic:a": "5" }, "expected": "[]" },
    { "name": "an unknown format without a fallback belongs to the topic", "text": "[{topic:a/bc:X2}]", "values": { "topic:a/bc": "5" }, "expected": "[]" },

    { "name": "a colon inside a topic", "text": "{topic:a:b}", "values": { "topic:a:b": "x" }, "expected": "x" },
    { "name": "a colon inside a topic, then a format", "text": "{topic:a:b:F1}", "values": { "topic:a:b": "2.25" }, "expected": "2.3" },
    { "name": "a JSON path after #", "text": "{topic:van/data#temp:F1} °C", "values": { "topic:van/data#temp": "21.44" }, "expected": "21.4 °C" },
    { "name": "running text with several values", "text": "Frisch {topic:t/1:F0} %, Grau {topic:t/2:F0} %", "values": { "topic:t/1": "72.4", "topic:t/2": "8.6" }, "expected": "Frisch 72 %, Grau 9 %" },

    { "name": "device:model", "text": "{device:model}", "values": { "device:model": "Waveshare Knob-Touch LCD 1.8" }, "expected": "Waveshare Knob-Touch LCD 1.8" },
    { "name": "device:id", "text": "ID {device:id}", "values": { "device:id": "gleaming-harvest" }, "expected": "ID gleaming-harvest" },
    { "name": "project:name", "text": "{project:name}", "values": { "project:name": "Van Sommer 2026" }, "expected": "Van Sommer 2026" },
    { "name": "reserved: device:name (issue #19)", "text": "{device:name}", "values": { "device:name": "Kombuese" }, "expected": "{device:name}" },
    { "name": "reserved: project:version (issue #18)", "text": "{project:version}", "values": { "project:version": "12" }, "expected": "{project:version}" },
    { "name": "nothing after the namespace", "text": "{topic:}", "expected": "{topic:}" }
  ]
}
